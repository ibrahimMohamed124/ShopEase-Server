# انسخ الملف ده لـ .env واملأ القيم الحقيقية. الملف ده نفسه (.env.example)
# آمن إنه يتعمله commit — مفيهوش أي سر حقيقي. الملف .env نفسه متضاف في
# .gitignore بالفعل ومينفعش يتعمله commit أبدًا.

NODE_ENV=development
PORT=3000

# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/shopease

# اعمل generate لكل واحد فيهم بأمر زي:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# لازم يكونوا سترنج طويل عشوائي (32+ حرف)، ومختلفين عن بعض
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# في production استخدم مزوّد transactional email زي SendGrid/Resend/SES
# بدل Gmail SMTP (Gmail محدود بـ500 إيميل/يوم ومش مصمم لكميات production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password-or-api-key
SMTP_FROM_NAME=ShopEase
SMTP_FROM_EMAIL=no-reply@example.com

# الدومين اللي بيتحط في روابط الإيميلات (زي رابط reset password)
APP_URL=http://localhost:3000

# قايمة الـfrontend origins المسموح لها تكلم الـAPI، مفصولة بفاصلة.
# مطلوبة في production (السيرفر مش هيشتغل من غيرها لو NODE_ENV=production).
# في development ممكن تسيبها فاضية وهترجع لـlocalhost:5173/3000 تلقائيًا.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
